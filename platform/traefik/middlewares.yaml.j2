---
# Middlewares compartilhados, no mesmo namespace do Traefik. A referência num Ingress
# é sempre `<namespace>-<nome>@kubernetescrd`, então estes dois são reutilizáveis de
# qualquer namespace sem precisar duplicar o objeto.
apiVersion: traefik.io/v1alpha1
kind: Middleware
metadata:
  name: security-headers
  namespace: kube-system
spec:
  headers:
    # HSTS. `includeSubdomains` é um compromisso real: depois que um navegador vê este
    # header, ele se recusa a falar HTTP com qualquer subdomínio do host até o prazo
    # expirar. Vale aqui porque todo host das duas zonas é servido só por HTTPS com
    # certificado do cert-manager — não existe subdomínio HTTP pra quebrar.
    stsSeconds: 31536000
    stsIncludeSubdomains: true
    contentTypeNosniff: true
    frameDeny: true
    referrerPolicy: strict-origin-when-cross-origin
---
apiVersion: traefik.io/v1alpha1
kind: Middleware
metadata:
  name: public-rate-limit
  namespace: kube-system
spec:
  rateLimit:
    average: {{ traefik_rate_limit_average }}
    burst: {{ traefik_rate_limit_burst }}
    period: {{ traefik_rate_limit_period }}
    sourceCriterion:
      # Sem sourceCriterion o Traefik conta por IP de origem da conexão TCP — que, com
      # a Cloudflare na frente, é sempre um IP dela. Resultado: todos os visitantes
      # dividiriam o mesmo bucket e um único cliente ruidoso geraria 429 pro resto.
      #
      # É por isso também que este middleware NÃO entra na lista global do entrypoint
      # websecure: requisição sem esse header (todo o tráfego que chega pela tailnet)
      # cai num único bucket compartilhado, e os consoles começariam a tomar 429 uns
      # por causa dos outros. Aplicar só em Ingress público, por annotation.
      requestHeaderName: Cf-Connecting-Ip
