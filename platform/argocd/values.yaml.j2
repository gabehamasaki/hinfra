## Valores do Helm chart argo/argo-cd - componentes não usados desligados (recursos: 2vCPU/8GB)
## e ArgoCD acessível só via Tailscale (nunca exposto publicamente) - ver README.

dex:
  enabled: false

notifications:
  enabled: true
  argocdUrl: "https://argocd.{{ infra_domain }}"
  secret:
    create: true
    items:
      discord-webhook-url: "{{ vault_alertmanager_discord_webhook_url }}"
  notifiers:
    service.webhook.discord: |
      url: $discord-webhook-url
      headers:
        - name: Content-Type
          value: application/json
  cm:
    create: true
    subscriptions:
      - recipients:
          - discord
        triggers:
          - on-health-degraded
          - on-sync-failed
          - on-sync-status-unknown
    templates:
      template.discord-health-degraded: |
        webhook:
          discord:
            method: POST
            body: |
{% raw %}
              {"content": "[ArgoCD] Application **{{.app.metadata.name}}** health: {{.app.status.health.status}} — {{.context.argocdUrl}}/applications/{{.app.metadata.name}}"}
{% endraw %}
      template.discord-sync-failed: |
        webhook:
          discord:
            method: POST
            body: |
{% raw %}
              {"content": "[ArgoCD] Sync failed for **{{.app.metadata.name}}**: {{.app.status.operationState.message}}"}
{% endraw %}
      template.discord-sync-unknown: |
        webhook:
          discord:
            method: POST
            body: |
{% raw %}
              {"content": "[ArgoCD] Application **{{.app.metadata.name}}** sync status Unknown — check repo-server logs."}
{% endraw %}
    triggers:
      trigger.on-health-degraded: |
{% raw %}
        - when: app.status.health.status == 'Degraded' || app.status.health.status == 'Missing'
          send: [discord-health-degraded]
{% endraw %}
      trigger.on-sync-failed: |
{% raw %}
        - when: app.status.operationState.phase in ['Error', 'Failed']
          send: [discord-sync-failed]
{% endraw %}
      trigger.on-sync-status-unknown: |
{% raw %}
        - when: app.status.sync.status == 'Unknown'
          send: [discord-sync-unknown]
{% endraw %}
  resources:
    requests:
      cpu: 25m
      memory: 64Mi
    limits:
      memory: 128Mi

applicationSet:
  # Este chart não tem mais toggle "enabled" - só dá pra zerar via replicas.
  replicas: 0

configs:
  cm:
    # Kustomize helmCharts em platform/observability exige --enable-helm no repo-server.
    kustomize.buildOptions: --enable-helm
  params:
    server.insecure: true   # TLS é terminado no Ingress (Traefik), não no próprio ArgoCD server

server:
  resources:
    requests:
      cpu: 50m
      memory: 128Mi
    limits:
      memory: 256Mi
  ingress:
    enabled: true
    ingressClassName: traefik
    annotations:
      cert-manager.io/cluster-issuer: letsencrypt-cloudflare
      traefik.ingress.kubernetes.io/router.middlewares: "{{ argocd_namespace }}-argocd-tailnet-only@kubernetescrd"
    hostname: "argocd.{{ infra_domain }}"
    tls: true

repoServer:
  resources:
    requests:
      cpu: 50m
      memory: 128Mi
    limits:
      memory: 256Mi

controller:
  resources:
    requests:
      cpu: 100m
      memory: 256Mi
    limits:
      memory: 512Mi

redis:
  resources:
    requests:
      cpu: 25m
      memory: 64Mi
    limits:
      memory: 128Mi
