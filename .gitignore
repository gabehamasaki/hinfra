# Ansible
*.retry
ansible/group_vars/all/vault.yml
!ansible/group_vars/all/vault.yml.example
ansible/group_vars/all/local.yml
!ansible/group_vars/all/local.yml.example
ansible/inventory/hosts.ini
!ansible/inventory/hosts.ini.example
.local-hinfra-workloads/
ansible/.secrets/          # chaves SSH privadas geradas pelo bootstrap.yml - NUNCA commitar
.secrets/

# Local kubeconfigs pulled from the server
*.kubeconfig
kubeconfig*.yaml

# Sealed Secrets master key backup - never commit the raw key
*sealed-secrets-key*.yaml
!platform/sealed-secrets/README.md

# Misc
.DS_Store

# O harness do Claude (CLAUDE.md, skills, permissões) é versionado de propósito -
# é o que faz qualquer sessão neste repo já saber operar a infra. Só a config
# pessoal de cada máquina fica de fora.
.claude/settings.local.json
