---
# Copie para vault.yml, preencha, depois: ansible-vault encrypt ansible/group_vars/all/vault.yml
# vault.yml NÃO é commitado (repo público). Mantenha só na sua máquina.

vault_tailscale_authkey: "tskey-auth-xxxxxxxxxxxx"
vault_cloudflare_api_token: "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# ArgoCD clone do repo privado hinfra-workloads (read). CI dos projetos usa outro PAT (write).
vault_workloads_repo_token: "github_pat_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

vault_r2_access_key_id: "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
vault_r2_secret_access_key: "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

vault_postgres_superuser_password: "xxxxxxxxxxxxxxxxxxxxxxxx"
vault_valkey_password: "xxxxxxxxxxxxxxxxxxxxxxxxxx"
vault_rustfs_access_key: "xxxxxxxxxxxxxxxxxxxx"
vault_rustfs_secret_key: "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# Observabilidade (Alertmanager, ArgoCD notifications, falha de backup k3s)
vault_alertmanager_discord_webhook_url: "https://discord.com/api/webhooks/000000000000000000/xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# Opcional: canal ou ntfy/Pushover só para severity=critical no Prometheus
# vault_alertmanager_critical_webhook_url: "https://discord.com/api/webhooks/..."
vault_grafana_admin_password: "xxxxxxxxxxxxxxxxxxxxxxxx"

# Opcional: ping após backup k3s bem-sucedido (ex. URL do healthchecks.io)
# vault_k3s_backup_healthcheck_url: "https://hc-ping.com/xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
