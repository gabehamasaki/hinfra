; Gerado pelo Ansible - contém credenciais, modo 0600.
; R2 é compatível com S3; o endpoint é derivado do account id da Cloudflare.
[{{ k3s_backup_remote_name }}]
type = s3
provider = Cloudflare
region = auto
endpoint = https://{{ r2_account_id }}.r2.cloudflarestorage.com
access_key_id = {{ vault_r2_access_key_id }}
secret_access_key = {{ vault_r2_secret_access_key }}
acl = private
no_check_bucket = true
; O R2 não implementa `versionId`, que o rclone usa no HEAD de leitura-de-volta
; logo após o PUT - o upload dá certo e só essa confirmação retorna 501. O
; script faz a verificação por conta própria com `rclone lsf` depois do copy.
no_head = true
